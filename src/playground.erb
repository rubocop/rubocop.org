---
layout: default
title: Playground
description: Run RuboCop in your browser. Paste some Ruby, see the offenses, try the autocorrections.
permalink: /playground/
nav: playground
page_class: wide
main_class: pg
---
<% playground = site.data.playground %>
<div id="playground"
     data-worker="<%= asset_path "javascript/playground/worker.js" %>"
     data-ruby="<%= playground.ruby %>"
     data-runtime="<%= playground.runtime_url %>"
     data-runtime-size="<%= playground.runtime_size %>"
     data-gems="<%= relative_url "/playground/#{playground.bundle}" %>"
     data-gems-size="<%= playground.bundle_size %>">
  <div class="page-head">
    <h1>Playground</h1>
    <p class="comment"># RuboCop <%= site.data.rubocop.version %> on Ruby <%= playground.ruby %>, compiled to WebAssembly. Your code stays in this tab.</p>
  </div>

  <div class="split">
    <section class="pane src" aria-label="Input">
      <div class="tabs" role="tablist">
        <span class="tab" role="tab" aria-selected="true" data-pane="ed-code"><input id="file" value="example.rb" spellcheck="false" aria-label="File name" title="Rename the file: some cops care (try Gemfile)"></span>
        <button type="button" role="tab" aria-selected="false" data-pane="ed-config">.rubocop.yml</button>
        <span class="fill"></span>
        <button class="act link-button" id="reset" type="button" title="Back to the example">reset</button>
      </div>
      <div class="editor" id="ed-code"></div>
      <div class="editor" id="ed-config" hidden></div>
    </section>

    <section class="pane out term" aria-label="RuboCop output">
      <div class="tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-mode="lint">rubocop</button>
        <button type="button" role="tab" aria-selected="false" data-mode="diff"><span class="long">rubocop&nbsp;</span>-a<span class="long">&nbsp;--diff</span></button>
        <button type="button" role="tab" aria-selected="false" data-mode="diff-all"><span class="long">rubocop&nbsp;</span>-A<span class="long">&nbsp;--diff</span></button>
        <span class="fill"></span>
        <button class="act link-button" id="apply" type="button" hidden>apply</button>
      </div>
      <pre id="output" aria-live="polite"><noscript>The playground runs RuboCop with JavaScript and WebAssembly, so it needs both.</noscript></pre>
    </section>
  </div>

  <div class="status">
    <span id="state">loading</span>
    <span class="fill"></span>
    <button id="share" type="button" class="link-button">copy link</button>
    <a href="https://github.com/rubocop/rubocop.org/issues/new">report a problem</a>
  </div>
</div>

<script src="<%= asset_path "javascript/playground/index.js" %>" defer></script>
