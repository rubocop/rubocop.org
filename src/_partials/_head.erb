<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= resource.data.title ? "#{resource.data.title} | #{site.metadata.title}" : "#{site.metadata.title}: #{site.metadata.tagline}" %></title>
<meta name="description" content="<%= resource.data.description || site.metadata.description %>">

<meta property="og:title" content="<%= resource.data.title || site.metadata.title %>">
<meta property="og:description" content="<%= resource.data.description || site.metadata.description %>">
<meta property="og:image" content="<%= absolute_url "/images/rubo-logo-horizontal.png" %>">
<meta property="og:type" content="website">

<link rel="icon" href="<%= relative_url "/images/favicon.ico" %>" type="image/x-icon">

<%# Applies a saved theme before the first paint, so dark mode doesn't flash. %>
<script>try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t } catch (e) {}</script>

<link rel="stylesheet" href="<%= asset_path :css %>">
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
