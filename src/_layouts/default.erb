<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <%= render "head", resource: resource %>
  </head>
  <body class="<%= data.page_class %>">
    <a class="skip" href="#main">Skip to content</a>
    <%= render "header", resource: resource %>

    <main id="main" class="<%= data.main_class %>">
      <%= yield %>
    </main>

    <%= render "footer", resource: resource %>
  </body>
</html>
